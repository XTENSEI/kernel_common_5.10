menuconfig GRAYRAVENS_PERF
	bool "GrayRavens performance helpers"
	depends on CPU_FREQ
	default y
	help
	  Small frequency and reclaim helpers implemented as freq_qos requests
	  rather than as a cpufreq governor.  The governor keeps its own
	  decision making and merely sees one more QoS client, so no scheduler
	  or thermal hot path is touched and no vendor ABI changes.

	  Each helper can be switched off at runtime from
	  /sys/kernel/grayravens/.

	  If unsure, say Y.

if GRAYRAVENS_PERF

config GRAYRAVENS_BOOT_BOOST
	bool "Boost CPU frequency for a short while after boot"
	default y
	help
	  Raise the frequency floor to the policy maximum shortly after boot,
	  hold it, then release.  Helps the cold start of the launcher and the
	  first app launch after a reboot.

config GRAYRAVENS_TOUCH_BOOST
	bool "Boost CPU frequency on touch input"
	depends on INPUT
	default y
	help
	  Raise the frequency floor while the touchscreen reports a new
	  contact, so the first frame after a tap is not computed at the
	  minimum frequency.  The floor is released by a delayed work item, so
	  a continuous drag keeps it raised without any extra work.

config GRAYRAVENS_RECLAIM_TUNE
	bool "Reclaim tuning (kswapd affinity, swappiness)"
	depends on SWAP
	default y
	help
	  Keep kswapd0 on a prime core so reclaim does not queue behind little
	  core scheduling, and lower vm.swappiness to 30.

config GRAYRAVENS_SCREEN_CLAMP
	bool "Cap CPU frequency while the screen is off"
	depends on DRM && KPROBES
	default y
	help
	  Hook the connector DPMS commit and, while the display is blanked, cap
	  every policy at a fraction of its maximum frequency.  The cap is a
	  freq_qos maximum request, so it can only lower a frequency the
	  governor already picked.  The trigger is edge-driven through the DRM
	  commit path, so nothing polls and nothing runs while the screen state
	  is steady.

	  Runtime switches are in /sys/kernel/grayravens/screen/.

config GRAYRAVENS_SCREEN_PCT
	int "Screen-off ceiling (percent of policy maximum)"
	depends on GRAYRAVENS_SCREEN_CLAMP
	default 30
	range 5 100

config GRAYRAVENS_AUDIO_RT
	bool "Raise the priority of audio threads"
	depends on KPROBES && CPU_IDLE
	default y
	help
	  Watch the scheduler's thread-rename point for the audio mixer threads
	  and lift each one, once, to a fixed SCHED_FIFO priority, plus request a
	  short CPU wake-up latency so the cluster does not stay in a deep idle
	  state between audio periods.  Threads that are already real-time are
	  skipped, so this can never demote a thread the vendor stack boosted.

	  Runtime switches are in /sys/kernel/grayravens/audio/.

config GRAYRAVENS_AUDIO_PRIO
	int "Audio thread SCHED_FIFO priority"
	depends on GRAYRAVENS_AUDIO_RT
	default 2
	range 1 20

config GRAYRAVENS_AUDIO_LATENCY_US
	int "CPU wake-up latency request while enabled (us)"
	depends on GRAYRAVENS_AUDIO_RT
	default 100
	range 0 1000
	help
	  A system-wide PM QoS latency request.  Lower values keep CPUs out of
	  deep idle states, which cuts audio wake-up jitter at a battery cost.
	  Set to 0 to only change thread priorities.

config GRAYRAVENS_BOOST_PCT
	int "Touch boost floor (percent of policy maximum)"
	default 100
	range 10 100
	help
	  How far the touch boost raises the frequency floor, as a percentage
	  of each policy's maximum frequency.  Adjustable at runtime through
	  /sys/kernel/grayravens/boost_pct.

config GRAYRAVENS_BOOT_DELAY_MS
	int "Boot boost delay (ms)"
	default 10000
	help
	  Delay between late init and the start of the boot boost.

config GRAYRAVENS_BOOT_HOLD_MS
	int "Boot boost hold time (ms)"
	default 10000

config GRAYRAVENS_TOUCH_HOLD_MS
	int "Touch boost hold time (ms)"
	default 120
	help
	  How long the touch boost floor stays in place after the last input
	  event.  Each new event pushes it back, so a swipe holds it for its
	  whole duration.

config GRAYRAVENS_IOPRIO
	bool "Foreground I/O priority boost"
	default y
	help
	  Raise the io priority of a process group named from userspace, so a
	  game's reads are served before background work.  BFQ and mq-deadline
	  both honour ioprio in this tree.  The group is put back on its
	  nice-derived best-effort level on release.

config GRAYRAVENS_UCLAMP
	bool "Foreground uclamp floor"
	depends on UCLAMP_TASK
	default y
	help
	  Raise the uclamp_min of a task named from userspace for a short
	  hold window, then drop it.  Same effect as a wake-path boost with
	  no code on the wake path.

endif # GRAYRAVENS_PERF
